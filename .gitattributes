# Normalise line endings in the repository to LF.
#
# Without this, committing from Windows stores CRLF, and the Vercel build (Linux)
# sees a diff on every file. It also makes `git diff` unreadable the first time
# anyone opens the project on a Mac.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.docx binary
*.onnx binary
*.pdf binary
