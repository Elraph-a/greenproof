# Copy to .env and fill in. Vite only reads env at STARTUP - restart the dev
# server after editing, or you will be debugging a value that was never loaded.
#
# Supabase dashboard -> Project Settings -> API

# Looks like https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "public" key. This SHIPS INSIDE THE BROWSER and is public by
# design - that is fine. What stops a user forging a verification result is the
# column-level GRANTs in supabase/migrations/0002_rls_grants.sql, which never
# give a client write access to confidence / verdict / signals.
VITE_SUPABASE_ANON_KEY=

# The Hugging Face Space, e.g. https://<user>-greenproof.hf.space
# Leave EMPTY until the ML service is deployed. Empty is safe: check-ins simply
# stay `pending` and get picked up later by POST /backfill, which is why T0 can
# run before the service exists.
VITE_ML_URL=

# LOCAL DEMO MODE. 1 = read seeded fixtures from src/lib/demo.ts and serve
# photos from public/demo; Supabase is never touched and every write path
# refuses. Useful for reviewing screens without spending the storage allowance.
#
# MUST BE 0 (or absent) IN PRODUCTION. If it ships as 1, the app shows eight
# fake trees and silently refuses every real registration. Unset is safe - the
# check is `=== '1'`, so anything else means off. A red banner appears across
# the top whenever it is on, so a mistake is visible immediately.
VITE_DEMO=0

# NEVER put the service_role key in this file. It lives only in the Hugging Face
# Space's secrets. Anything with a VITE_ prefix is compiled into the JS bundle
# and readable by anyone who opens devtools.
